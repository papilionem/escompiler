fn @fib(%n: i32) -> i32 {
  bb0:
    %v0: i32 = const_i32 0
    %v1: i32 = const_i32 2
    %v2: bool = lt_i32 %v0, %v1
    br_if %v2, bb1, bb2
  bb1:
